# Browser-safe application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Local seed/bootstrap only. Do not reuse this password outside local development.
DEMO_ADMIN_EMAIL=admin@magicalweddings.test
DEMO_ADMIN_PASSWORD=choose-a-local-password

# Allows the built-in fictitious public demo when Supabase is unavailable.
DEMO_MODE=false
